{
  "name": "task-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "db:migrate": "pnpm --filter @task-tracker/api db:migrate",
    "db:seed": "pnpm --filter @task-tracker/api db:seed",
    "db:generate-types": "pnpm --filter @task-tracker/api db:generate-types"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.6",
    "turbo": "^2.3.0",
    "vitest": "^2.1.6"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20"
  }
}
